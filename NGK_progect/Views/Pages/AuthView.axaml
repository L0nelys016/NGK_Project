<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:NGK_progect.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NGK_progect.Views.AuthView"
			 x:DataType="vm:AuthViewModel">

	<Grid RowDefinitions="Auto,*"
		  HorizontalAlignment="Center"
		  VerticalAlignment="Center">
		<TabControl Grid.Row="1" Margin="20">
			<TabItem Header="Вход">
				<StackPanel>
					<StackPanel Spacing="10" Margin="10, 10, 0, 0" HorizontalAlignment="Center">
						<Border BorderBrush="Gray"
									BorderThickness="1"
									CornerRadius="4"
									Background="White"
									Width="250">
							<TextBox
								Classes="LogIn"
								Watermark="Логин"
								MaxWidth="250"
								Margin="10,0,35,0"
								Text="{Binding Login}"/>
						</Border>

						<StackPanel Orientation="Horizontal" Spacing="5">
							<Border BorderBrush="Gray"
									BorderThickness="1"
									CornerRadius="4"
									Background="White"
									Width="250">
								<Grid Width="250">
									<TextBox
											 Classes="LogIn"
											 x:Name="PasswordTextBox"
											 Watermark="Пароль" 
											 PasswordChar="{Binding PasswordChar}"
											 Margin="10,0,35,0"
											 BorderThickness="0"
											 Background="Transparent"
											 Text="{Binding Password}"/>

									<Button x:Name="ShowPasswordButton"
											Width="30"
											Height="30"
											Background="Transparent"
											Command="{Binding TogglePasswordVisibilityCommand}"
											IsVisible="{Binding !IsPasVisible}"
											BorderThickness="0"
											HorizontalAlignment="Right"
											Margin="0,0,5,0">
										<PathIcon Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
									</Button>

									<Button x:Name="HidePasswordButton"
											Width="30"
											Height="30"
											Background="Transparent"
											Command="{Binding TogglePasswordVisibilityCommand}"
											IsVisible="{Binding IsPasVisible}"
											BorderThickness="0"
											HorizontalAlignment="Right"
											Margin="0,0,5,0">
										<PathIcon Data="M20.722,24.964c0.096,0.096,0.057,0.264-0.073,0.306c-7.7,2.466-16.032-1.503-18.594-8.942  c-0.072-0.21-0.072-0.444,0-0.655c0.743-2.157,1.99-4.047,3.588-5.573c0.061-0.058,0.158-0.056,0.217,0.003l4.302,4.302  c0.03,0.03,0.041,0.072,0.031,0.113c-1.116,4.345,2.948,8.395,7.276,7.294c0.049-0.013,0.095-0.004,0.131,0.032  C17.958,22.201,20.045,24.287,20.722,24.964z M24.68,23.266c2.406-1.692,4.281-4.079,5.266-6.941c0.072-0.21,0.072-0.44,0-0.65  C27.954,9.888,22.35,6,16,6c-2.479,0-4.841,0.597-6.921,1.665L3.707,2.293c-0.391-0.391-1.023-0.391-1.414,0s-0.391,1.023,0,1.414  l26,26c0.391,0.391,1.023,0.391,1.414,0c0.391-0.391,0.391-1.023,0-1.414L24.68,23.266z M16,10c3.309,0,6,2.691,6,6  c0,1.294-0.416,2.49-1.115,3.471l-8.356-8.356C13.51,10.416,14.706,10,16,10z"/>
									</Button>
								</Grid>
							</Border>
						</StackPanel>

						<Button CornerRadius="12"
								Background="{StaticResource SkyBlueBrash}"
								Content="Войти"
								Width="60"
								HorizontalAlignment="Center"
								HorizontalContentAlignment="Center"
								IsEnabled="{Binding IsEnableButtonSignIn}"
								Command="{Binding LoginAndPasswordVerificationCommand}"/>

					</StackPanel>
					<TextBlock Classes="RedError" 
							   HorizontalAlignment="Center"
							   Text="{Binding ErrorMessageSignIn}"
							   Margin="10,5,0,0"/>
				</StackPanel>
			</TabItem>

			<TabItem Header="Регистрация">
				<StackPanel>
					<StackPanel Spacing="10" Margin="10" HorizontalAlignment="Center">
						<Border BorderBrush="Gray"
									BorderThickness="1"
									CornerRadius="4"
									Background="White"
									Width="250">
							<TextBox
								Classes="LogIn"
								Watermark="Логин"
								MaxWidth="250"
								Margin="10,0,35,0"
								Text="{Binding Login}"/>
						</Border>



						<Border BorderBrush="Gray"
									BorderThickness="1"
									CornerRadius="4"
									Background="White"
									Width="250">
							<TextBox
								Classes="LogIn"
								Watermark="Email"
								MaxWidth="250"
								Margin="10,0,35,0"
								Text="{Binding Email}"/>
						</Border>

						<Border BorderBrush="Gray"
									BorderThickness="1"
									CornerRadius="4"
									Background="White"
									Width="250">
							<TextBox
								Classes="LogIn"
								Watermark="Имя"
								MaxWidth="250"
								Margin="10,0,35,0"
								Text="{Binding FirstName}"/>
						</Border>

						<Border BorderBrush="Gray"
									BorderThickness="1"
									CornerRadius="4"
									Background="White"
									Width="250">
							<TextBox
								Classes="LogIn"
								Watermark="Фамилия"
								MaxWidth="250"
								Margin="10,0,35,0"
								Text="{Binding LastName}"/>
						</Border>

						<StackPanel Orientation="Horizontal" Spacing="5">
							<Border
									BorderBrush="Gray"
									BorderThickness="1"
									CornerRadius="4"
									Background="White"
									Width="250">
								<Grid Width="250">
									<TextBox
											 Classes="LogIn"
											 x:Name="RegPasswordTextBox"
											 Watermark="Пароль"
											 Text="{Binding Password}"
											 PasswordChar="{Binding PasswordChar}"
											 Margin="10,0,35,0"
											 BorderThickness="0"
											 Background="Transparent"/>

									<Button x:Name="RegShowPasswordButton"
											Width="30"
											Height="30"
											Background="Transparent"
											Command="{Binding TogglePasswordVisibilityCommand}"
											IsVisible="{Binding !IsPasVisible}"
											BorderThickness="0"
											HorizontalAlignment="Right"
											Margin="0,0,5,0">
										<PathIcon Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
									</Button>

									<Button x:Name="RegHidePasswordButton"
											Width="30"
											Height="30"
											Background="Transparent"
											Command="{Binding TogglePasswordVisibilityCommand}"
											IsVisible="{Binding IsPasVisible}"
											BorderThickness="0"
											HorizontalAlignment="Right"
											Margin="0,0,5,0">
										<PathIcon Data="M20.722,24.964c0.096,0.096,0.057,0.264-0.073,0.306c-7.7,2.466-16.032-1.503-18.594-8.942  c-0.072-0.21-0.072-0.444,0-0.655c0.743-2.157,1.99-4.047,3.588-5.573c0.061-0.058,0.158-0.056,0.217,0.003l4.302,4.302  c0.03,0.03,0.041,0.072,0.031,0.113c-1.116,4.345,2.948,8.395,7.276,7.294c0.049-0.013,0.095-0.004,0.131,0.032  C17.958,22.201,20.045,24.287,20.722,24.964z M24.68,23.266c2.406-1.692,4.281-4.079,5.266-6.941c0.072-0.21,0.072-0.44,0-0.65  C27.954,9.888,22.35,6,16,6c-2.479,0-4.841,0.597-6.921,1.665L3.707,2.293c-0.391-0.391-1.023-0.391-1.414,0s-0.391,1.023,0,1.414  l26,26c0.391,0.391,1.023,0.391,1.414,0c0.391-0.391,0.391-1.023,0-1.414L24.68,23.266z M16,10c3.309,0,6,2.691,6,6  c0,1.294-0.416,2.49-1.115,3.471l-8.356-8.356C13.51,10.416,14.706,10,16,10z"/>
									</Button>
								</Grid>
							</Border>
						</StackPanel>

						<StackPanel Orientation="Horizontal" Spacing="5">
							<Border
									BorderBrush="Gray"
									BorderThickness="1"
									CornerRadius="4"
									Background="White"
									Width="250">
								<Grid Width="250">
									<TextBox
											 Classes="LogIn"
											 x:Name="RegConfimPasswordTextBox"
											 Watermark="Подтвердите пароль"
											 PasswordChar="*"
											 Margin="10,0,35,0"
											 BorderThickness="0"
											 Background="Transparent"
											 Text="{Binding PasswordConfim}"/>
								</Grid>
							</Border>
						</StackPanel>

						<Button CornerRadius="12"
							Background="{StaticResource SkyBlueBrash}"
							Command="{Binding RegisterNewUserCommand}"
							Content="Зарегистрироваться"
							Width="180"
							HorizontalAlignment="Center"
							HorizontalContentAlignment="Center"/>
					</StackPanel>
					<TextBlock Classes="RedError"
							   HorizontalAlignment="Center"
							   Text="{Binding ErrorMessageSignUp}"
							   Margin="10,5,0,0"/>
					</StackPanel>
			</TabItem>
		</TabControl>
	</Grid>
</UserControl>